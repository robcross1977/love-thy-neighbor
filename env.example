# Database
DATABASE_URL="postgresql://username:password@localhost:5432/love_thy_neighbor"

# Server Configuration
PORT=7777

# NextAuth v5 with Auth0
NEXTAUTH_URL="http://localhost:7777"
NEXTAUTH_SECRET="your-nextauth-secret-key-here-make-it-long-and-random"
AUTH_TRUST_HOST=true

# Auth0 Configuration
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"
AUTH0_DOMAIN="https://your-domain.auth0.com"

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# App Configuration
NEXT_PUBLIC_APP_NAME="Love Thy Neighbor"
NEXT_PUBLIC_APP_URL="http://localhost:7777"
NEXT_PUBLIC_DEFAULT_RADIUS_KM="10" 